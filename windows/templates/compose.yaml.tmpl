# Generated by the BrokerSRE Windows host kit (windows/setup.ps1) from
# windows/templates/compose.yaml.tmpl. Do not edit by hand: re-run setup.ps1 with the options
# you want (it refuses to replace a differing file unless you pass -Force, and keeps a backup).
#
# The IBKR username and password are NOT in this file. They are two files in ./secrets, written
# as UTF-8 without byte-order mark and without newline, mounted read-only as Docker secrets.
name: __PROJECT_NAME__

services:
  ib-gateway:
    # Pin the image by digest in production (image@sha256:...); a tag can move.
    image: __IMAGE_REF__
    container_name: __CONTAINER_NAME__
    # unless-stopped: comes back after a Docker or Windows restart, stays down after an explicit
    # stop. Nothing restarts a running gateway: a restart forces a new login with 2FA.
    restart: unless-stopped
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    # IB Gateway needs up to a minute to shut down tidily; Docker's default is 10 s.
    stop_grace_period: 90s
    ulimits:
      nofile:
        soft: 65536
        hard: 65536
    tmpfs:
      # A tmpfs is root-owned 0755 unless told otherwise and the gateway runs as uid 1000.
      - /tmp:size=64m
      - /run/brokersre:size=16m,uid=1000,gid=1000,mode=0750
    environment:
      TWS_USERID_FILE: /run/secrets/ib-username
      TWS_PASSWORD_FILE: /run/secrets/ib-password
      TRADING_MODE: __TRADING_MODE__
      READ_ONLY_API: "__READ_ONLY_API__"
      TWOFA_TIMEOUT_ACTION: restart
      RELOGIN_AFTER_TWOFA_TIMEOUT: "yes"
      TWOFA_EXIT_INTERVAL: "60"
      AUTO_RESTART_TIME: "__AUTO_RESTART_TIME__"
      TIME_ZONE: __TIME_ZONE__
      EXISTING_SESSION_DETECTED_ACTION: primary
      IBC_COMMAND_SERVER_PORT: "7462"
    secrets:
      - ib-username
      - ib-password
    volumes:
      - ibgw-settings:/home/ibgateway/Jts/settings
      - ibgw-logs:/var/log/ibgateway
    ports:
      # Loopback only: the API is reachable from this computer, never from the network.
      - "127.0.0.1:__HOST_PORT__:__RELAY_PORT__"
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "5"
    healthcheck:
      test: ["CMD", "/usr/local/lib/brokersre/healthcheck.sh"]
      interval: 15s
      timeout: 5s
      start_period: 300s
      retries: 3

secrets:
  ib-username:
    file: ./secrets/ib-username
  ib-password:
    file: ./secrets/ib-password

volumes:
  ibgw-settings:
  ibgw-logs:
