# Account-id redaction for every row that leaves the host. Loaded by the transforms
# events_out and raw_redacted in vector.yaml (remap `file:`), so the rules exist exactly once.
#
# Input   Any event (.). Output: the same event with every string value, at any depth,
#         rewritten: an IBKR account id keeps only its last three characters, as [ACCT:…567].
#         Keys, numbers, booleans and timestamps are untouched.
# Shape   An account id is an optional D (paper), then one of U, F, I, then zero to two
#         further letters, then 5 to 9 digits, and then NOT a letter or digit.
#         Evidence: IBKR documents the prefixes U (individual and sub accounts), F (advisor
#         or fund-manager master) and I (fully disclosed broker master):
#         https://www.interactivebrokers.com/campus/trading-lessons/hedge-fund-account-overview/
#         https://www.interactivebrokers.ie/download/applicationguide.pdf
#         Paper accounts start with DU (widely documented). A real paper session on
#         2026-11-16 showed DU, one more letter and six digits, a shape IBKR's documents do
#         not mention; the earlier pattern (DU, DF, U or F directly followed by the digits)
#         missed it. The second further letter is headroom, an assumption: rewriting a word
#         that is no id costs readability only, missing an id breaks the promise under Why.
# Rules   An id is recognised
#           1. in any case, when it stands on its own: start of text, punctuation, white space
#              or an underscore before it (U1234567, =u1234567;, acct_DUR123456, U1234567_x);
#           2. in upper case, glued to the end of a lower-case word (acctDUR123456);
#           3. in any case, right after an escaped line break or tab as text (\nU1234567).
#         Left alone on purpose: more than 9 digits (U1234567890), an id followed by letters
#         (f1234567abc is the middle of a hash), an upper-case letter before it (XDU1234567,
#         CPU12345), a first letter other than D, U, F, I (XYZ123456), a third further letter
#         (DUABC123456).
#         Rewritten although no id: every word of the shape (id12345, USD100000, disk12345).
# Copies  The shape is repeated in entrypoint.sh (account_like), ../vm/apply-config.sh
#         (good_label) and the sidecar (redaction.py, ACCOUNT_RE): change the four together.
# How     Rust regular expressions have no look-around. An underscore counts as a word
#         character, so it is swapped for a private-use character (U+E000) while rule 1 runs
#         with \b, and swapped back afterwards; text that already contains U+E000 keeps it.
# Why     "An account id may leave the container only as its last three characters" must hold
#         for every column of every stream, including keys the gateway adds later; walking all
#         string values makes that true by construction instead of per column.
. = map_values(., recursive: true) -> |value| {
  if is_string(value) {
    text = string!(value)
    marked = !contains(text, "\u{E000}")
    if marked {
      text = replace(text, "_", "\u{E000}")
    }
    text = replace_with(text, r'(?i)\bD?[UFI][A-Z]{0,2}\d{5,9}\b') -> |m| {
      "[ACCT:…" + slice!(m.string, -3) + "]"
    }
    text = replace_with(text, r'(?P<lead>[a-z])D?[UFI][A-Z]{0,2}\d{5,9}\b') -> |m| {
      string!(m.lead) + "[ACCT:…" + slice!(m.string, -3) + "]"
    }
    text = replace_with(text, r'(?P<lead>\\[nrt])(?i:D?[UFI][A-Z]{0,2})\d{5,9}\b') -> |m| {
      string!(m.lead) + "[ACCT:…" + slice!(m.string, -3) + "]"
    }
    if marked {
      text = replace(text, "\u{E000}", "_")
    }
    text
  } else {
    value
  }
}
