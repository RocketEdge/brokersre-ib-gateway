// Alert rule B "health" (azure/bicep/modules/alerts.bicep, every 5 minutes).
// Dimensions: Instance, Condition
//
// One rule, seven conditions (alert rules are billed per rule, so they share one). Fires per
// gateway instance and condition:
//   memory_high     memory working set above 85 % of the container limit for 10 minutes
//                   (every sample of the last 10 minutes, at least 10 samples); never fires for
//                   a container without a memory limit, because the share is not measured then;
//   restart_loop    3 or more container starts (distinct BootId) in 30 minutes;
//   oom_kill        the kernel killed a process of the container in the last 15 minutes (event
//                   oom_kill, or the OomKills counter rose);
//   disk_low        the gateway reported a nearly full volume (event disk_low) and has not
//                   reported disk_ok since, in the container start that is running now;
//   login_stalled   the login made no progress (event login_stalled) and has not resumed
//                   (login_resumed) since, in the container start that is running now;
//   needs_human     the gateway asked for a human (event needs_human) in the last 15 minutes;
//   unknown_window  IBC met a dialog it does not know (event unknown_window) in the last 15 minutes.
// Returns one row per instance and condition; nothing during the maintenance window (the daily
// restart logs out on purpose). The rule looks back two days (overrideQueryTimeRange) so that
// a state reported once, hours ago, is still known.
// Not here: IB API connectivity codes (1100 and friends). Only an API client sees them and no
// component writes them to the log volume yet (ADR 0012, follow-up).
//
// The two lines below are replaced by the Bicep module with the maintenanceWindowUtc
// parameter (time of day in UTC; equal values mean "no window"). Keep them exactly as they are.
let maintenance_start = time(00:00:00);
let maintenance_end = time(00:00:00);
let time_of_day = now() - startofday(now());
let in_maintenance = maintenance_start != maintenance_end
    and iff(maintenance_start < maintenance_end,
        time_of_day >= maintenance_start and time_of_day < maintenance_end,
        time_of_day >= maintenance_start or time_of_day < maintenance_end);
// The container start each instance is running now; a state of an older start is over.
let current_boot =
    IbGwMetrics_CL
    | where TimeGenerated > ago(2d)
    | where isnotempty(BootId)
    | summarize arg_max(TimeGenerated, BootId) by Instance
    | project Instance, BootId;
// "raised and not cleared since": the newest event of the pair, in the current start, is `raised`.
let unresolved = (raised: string, cleared: string) {
    IbGwEvents_CL
    | where TimeGenerated > ago(2d)
    | where Event in (raised, cleared)
    | join kind=inner current_boot on Instance, BootId
    | summarize arg_max(TimeGenerated, Event, Msg) by Instance
    | where Event == raised
    | project Instance, Condition = raised, Detail = Msg
};
// "happened recently": the newest such event of the last 15 minutes.
let recent = (name: string) {
    IbGwEvents_CL
    | where TimeGenerated > ago(15m)
    | where Event == name
    | summarize arg_max(TimeGenerated, Msg) by Instance
    | project Instance, Condition = name, Detail = Msg
};
let memory_high =
    IbGwMetrics_CL
    | where TimeGenerated > ago(10m)
    | where isnotnull(MemWorkingSetBytes) and MemLimitBytes > 0
    | summarize Samples = count(), LowestShare = min(todouble(MemWorkingSetBytes) / MemLimitBytes) by Instance
    | where Samples >= 10 and LowestShare > 0.85
    | project Instance, Condition = "memory_high",
        Detail = strcat("working set at or above ", toint(LowestShare * 100), " % of the limit for 10 min");
let restart_loop =
    union
        (IbGwEvents_CL | where TimeGenerated > ago(30m) | project Instance, BootId),
        (IbGwMetrics_CL | where TimeGenerated > ago(30m) | project Instance, BootId)
    | where isnotempty(BootId)
    | summarize Boots = dcount(BootId) by Instance
    | where Boots >= 3
    | project Instance, Condition = "restart_loop",
        Detail = strcat(Boots, " container starts in 30 min");
let oom_kill =
    union
        (IbGwEvents_CL
        | where TimeGenerated > ago(15m)
        | where Event == "oom_kill"
        | summarize Kills = count() by Instance),
        (IbGwMetrics_CL
        | where TimeGenerated > ago(15m)
        | where isnotnull(OomKills)
        | summarize Kills = max(OomKills) - min(OomKills) by Instance, BootId
        | summarize Kills = sum(Kills) by Instance)
    | summarize Kills = sum(Kills) by Instance
    | where Kills > 0
    | project Instance, Condition = "oom_kill",
        Detail = strcat(Kills, " OOM kill(s) in 15 min");
union memory_high, restart_loop, oom_kill,
    unresolved("disk_low", "disk_ok"), unresolved("login_stalled", "login_resumed"),
    recent("needs_human"), recent("unknown_window")
| where not(in_maintenance)
| project Instance, Condition, Detail
