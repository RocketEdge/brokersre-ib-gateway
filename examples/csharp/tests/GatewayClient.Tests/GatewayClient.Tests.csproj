<Project Sdk="Microsoft.NET.Sdk">
  <!-- xUnit v3 tests of the library, run by `dotnet test` on Microsoft.Testing.Platform
       (global.json). No IBKR assembly, no network: the broker is a scriptable fake. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>GatewayClient.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="AwesomeAssertions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\GatewayClient\GatewayClient.csproj" />
  </ItemGroup>
</Project>
